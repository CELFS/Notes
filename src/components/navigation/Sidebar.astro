---
import { SITE } from '../../config/site';
import type { NavigationGroup } from '../../lib/notes';
import Icon from '../ui/Icon.astro';
import NavGroup from './NavGroup.astro';

interface Props {
  tree: NavigationGroup;
  activeId?: string;
  activeRoute?: string;
}

const { tree, activeId, activeRoute } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="sidebar" id="site-navigation" aria-label={SITE.navigationLabel}>
  <div class="sidebar__top">
    <a class="brand" href={base} aria-label={`${SITE.title} · ${SITE.homeLabel}`}>
      <img class="brand__symbol" src={`${base}logo.png`} alt={SITE.logoAlt} width="34" height="34" />
      <span class="brand__title">{SITE.title}</span>
    </a>
    <button class="icon-button sidebar__toggle" id="navigation-toggle" type="button" aria-label={SITE.closeNavigation} aria-controls="site-navigation" aria-expanded="true">
      <Icon name="menu" />
    </button>
  </div>
  <nav class="sidebar__scroll custom-scrollbar">
    <a class="sidebar__home" href={base}><span aria-hidden="true">↖</span>{SITE.reader.backHome}</a>
    <div class="sidebar__collection">{SITE.reader.navigationCaption}</div>
    {tree.notes.map((note) => (
      <a class:list={['nav-link', { 'is-active': note.id === activeId }]} href={note.href} title={note.title}><span>{note.title}</span></a>
    ))}
    {tree.children.map((group) => <NavGroup group={group} activeId={activeId} activeRoute={activeRoute} />)}
  </nav>
</aside>
<button class="navigation-scrim" id="navigation-scrim" type="button" aria-label={SITE.closeNavigation}></button>

<script>
  import { SITE } from '../../config/site';

  const root = document.documentElement;
  const toggleButton = document.querySelector<HTMLButtonElement>('#navigation-toggle');
  const mobileNavigation = window.matchMedia('(max-width: 48rem)');

  const syncToggleButton = () => {
    if (!toggleButton) return;
    const isOpen = mobileNavigation.matches
      ? document.body.dataset.navigation === 'open'
      : root.dataset.sidebar !== 'collapsed';
    toggleButton.setAttribute('aria-expanded', String(isOpen));
    toggleButton.setAttribute('aria-label', isOpen ? SITE.closeNavigation : SITE.openNavigation);
    const sidebar = document.querySelector<HTMLElement>('#site-navigation');
    if (sidebar) sidebar.inert = mobileNavigation.matches && !isOpen;
    const workspace = document.querySelector<HTMLElement>('.content-workspace');
    if (workspace) workspace.inert = mobileNavigation.matches && isOpen;
  };

  const closeNavigation = () => {
    const wasOpen = document.body.dataset.navigation === 'open';
    delete document.body.dataset.navigation;
    syncToggleButton();
    if (wasOpen) document.querySelector<HTMLButtonElement>('#navigation-open-mobile')?.focus();
  };

  toggleButton?.addEventListener('click', () => {
    if (mobileNavigation.matches) {
      closeNavigation();
      return;
    }

    const collapsed = root.dataset.sidebar !== 'collapsed';
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    localStorage.setItem('notes-sidebar', collapsed ? 'collapsed' : 'expanded');
    syncToggleButton();
  });

  document.querySelector('#navigation-scrim')?.addEventListener('click', closeNavigation);
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.nav-group__link')) {
    link.addEventListener('click', (event) => event.stopPropagation());
  }
  new MutationObserver(syncToggleButton).observe(document.body, {
    attributes: true,
    attributeFilter: ['data-navigation'],
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && document.body.dataset.navigation === 'open') closeNavigation();
    if (event.key === 'Tab' && mobileNavigation.matches && document.body.dataset.navigation === 'open') {
      const controls = Array.from(document.querySelectorAll<HTMLElement>('#site-navigation a, #site-navigation button, #site-navigation summary'))
        .filter((control) => control.getClientRects().length > 0);
      const first = controls[0];
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
  const activeLink = document.querySelector<HTMLElement>('.sidebar__scroll .nav-link.is-active, .sidebar__scroll .nav-group__link.is-active');
  const navigationScroll = document.querySelector<HTMLElement>('.sidebar__scroll');
  if (activeLink && navigationScroll) {
    navigationScroll.scrollTop = Math.max(0, activeLink.offsetTop - navigationScroll.clientHeight / 2);
  }
  mobileNavigation.addEventListener('change', () => {
    if (!mobileNavigation.matches) closeNavigation();
    syncToggleButton();
  });
  syncToggleButton();
</script>
