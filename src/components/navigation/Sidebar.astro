---
import { SITE } from '../../config/site';
import type { NavigationGroup } from '../../lib/notes';
import Icon from '../ui/Icon.astro';
import NavGroup from './NavGroup.astro';

interface Props {
  tree: NavigationGroup;
  activeId?: string;
  activeRoute?: string;
}

const { tree, activeId, activeRoute } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="sidebar" id="site-navigation" aria-label={SITE.navigationLabel}>
  <div class="sidebar__top">
    <a class="brand" href={base} aria-label={`${SITE.title} · ${SITE.homeLabel}`}>
      <span class="brand__mark"><img src={`${base}logo.png`} alt={SITE.logoAlt} /></span>
      <span class="brand__title">{SITE.title}</span>
    </a>
    <button class="icon-button sidebar__toggle" id="navigation-toggle" type="button" aria-label={SITE.closeNavigation} aria-controls="site-navigation" aria-expanded="true">
      <Icon name="menu" />
    </button>
  </div>
  <div class="sidebar__header">
    <span>{SITE.navigationLabel}</span>
  </div>
  <nav class="sidebar__scroll custom-scrollbar">
    <a class:list={['nav-link nav-link--home', { 'is-active': !activeId && !activeRoute }]} href={base}>{SITE.homeLabel}</a>
    {tree.notes.map((note) => (
      <a class:list={['nav-link', { 'is-active': note.id === activeId }]} href={note.href}>{note.title}</a>
    ))}
    {tree.children.map((group) => <NavGroup group={group} activeId={activeId} activeRoute={activeRoute} />)}
  </nav>
</aside>
<button class="navigation-scrim" id="navigation-scrim" type="button" aria-label={SITE.closeNavigation}></button>

<script>
  import { SITE } from '../../config/site';

  const root = document.documentElement;
  const toggleButton = document.querySelector<HTMLButtonElement>('#navigation-toggle');
  const mobileNavigation = window.matchMedia('(max-width: 48rem)');

  const syncToggleButton = () => {
    if (!toggleButton) return;
    const isOpen = mobileNavigation.matches
      ? document.body.dataset.navigation === 'open'
      : root.dataset.sidebar !== 'collapsed';
    toggleButton.setAttribute('aria-expanded', String(isOpen));
    toggleButton.setAttribute('aria-label', isOpen ? SITE.closeNavigation : SITE.openNavigation);
  };

  const closeNavigation = () => {
    delete document.body.dataset.navigation;
    syncToggleButton();
  };

  toggleButton?.addEventListener('click', () => {
    if (mobileNavigation.matches) {
      closeNavigation();
      return;
    }

    const collapsed = root.dataset.sidebar !== 'collapsed';
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    localStorage.setItem('notes-sidebar', collapsed ? 'collapsed' : 'expanded');
    syncToggleButton();
  });

  document.querySelector('#navigation-scrim')?.addEventListener('click', closeNavigation);
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.nav-group__link')) {
    link.addEventListener('click', (event) => event.stopPropagation());
  }
  new MutationObserver(syncToggleButton).observe(document.body, {
    attributes: true,
    attributeFilter: ['data-navigation'],
  });
  mobileNavigation.addEventListener('change', syncToggleButton);
  syncToggleButton();
</script>
