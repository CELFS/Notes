---
import { getNavigationGroupContents, type NavigationGroup } from '../../lib/notes';
import Icon from '../ui/Icon.astro';
import NavGroupComponent from './NavGroup.astro';

interface Props {
  group: NavigationGroup;
  activeId?: string;
  activeRoute?: string;
  depth?: number;
}

const { group, activeId, activeRoute, depth = 0 } = Astro.props;
const contents = getNavigationGroupContents(group);
const containsActive = group.notes.some((note) => note.id === activeId)
  || activeId?.startsWith(`${group.route}/`)
  || activeRoute === group.route
  || activeRoute?.startsWith(`${group.route}/`);
---

<details class:list={['nav-group', { 'is-active': activeRoute === group.route }]} open={depth === 0 || containsActive}>
  <summary>
    <span class="nav-group__chevron"><Icon name="chevron" size={13} /></span>
    <a class:list={['nav-group__link', { 'is-active': activeRoute === group.route }]} href={group.href}>{group.label}</a>
  </summary>
  <div class="nav-group__content">
    {contents.notes.map((note) => (
      <a class:list={['nav-link', { 'is-active': note.id === activeId }]} href={note.href}>
        <span>{note.title}</span>
      </a>
    ))}
    {contents.children.map((child) => (
      <NavGroupComponent group={child} activeId={activeId} activeRoute={activeRoute} depth={depth + 1} />
    ))}
  </div>
</details>
