---
import { SITE } from '../../config/site';
import Icon from '../ui/Icon.astro';

const base = import.meta.env.BASE_URL;
---

<header class="topbar">
  <div class="topbar__leading">
    <button class="icon-button topbar__menu" id="navigation-open" type="button" aria-label={SITE.openNavigation}>
      <Icon name="menu" />
    </button>
    <a class="brand" href={base} aria-label={`${SITE.title} · ${SITE.homeLabel}`}>
      <span class="brand__mark"><img src={`${base}logo.png`} alt={SITE.logoAlt} /></span>
      <span>{SITE.title}</span>
    </a>
  </div>

  <div class="topbar__actions">
    <button class="search-trigger" id="search-open" type="button">
      <Icon name="search" size={16} />
      <span>{SITE.searchLabel}</span>
      <kbd>{SITE.searchShortcut}</kbd>
    </button>
    <button class="icon-button" id="theme-toggle" type="button" aria-label={SITE.switchToLight}>
      <span class="theme-icon theme-icon--dark"><Icon name="sun" /></span>
      <span class="theme-icon theme-icon--light"><Icon name="moon" /></span>
    </button>
    <a class="icon-button" href={SITE.repository} target="_blank" rel="noreferrer" aria-label={SITE.repositoryLabel}>
      <Icon name="github" />
    </a>
  </div>
</header>

<script>
  import { SITE } from '../../config/site';

  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const navigationButton = document.querySelector<HTMLButtonElement>('#navigation-open');

  const syncThemeButton = () => {
    if (!themeButton) return;
    const isDark = root.dataset.theme !== 'light';
    themeButton.setAttribute('aria-label', isDark ? SITE.switchToLight : SITE.switchToDark);
  };

  themeButton?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = nextTheme;
    localStorage.setItem('notes-theme', nextTheme);
    syncThemeButton();
  });

  navigationButton?.addEventListener('click', () => {
    document.body.dataset.navigation = 'open';
  });

  syncThemeButton();
</script>
