---
import { SITE } from '../../config/site';
---

<div
  id="code-enhancements"
  data-copy-label={SITE.copyCodeLabel}
  data-copied-label={SITE.copiedCodeLabel}
  hidden
></div>

<script>
  const settings = document.querySelector<HTMLElement>('#code-enhancements');
  const copyLabel = settings?.dataset.copyLabel ?? '';
  const copiedLabel = settings?.dataset.copiedLabel ?? '';
  const copyIcon = '<svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><rect width="13" height="13" x="9" y="9" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const copiedIcon = '<svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m5 12 4 4L19 6"></path></svg>';
  const languageNames: Record<string, string> = {
    asm: 'Assembly',
    bash: 'Bash',
    c: 'C',
    cpp: 'C++',
    css: 'CSS',
    html: 'HTML',
    javascript: 'JavaScript',
    js: 'JavaScript',
    json: 'JSON',
    matlab: 'MATLAB',
    perl: 'Perl',
    plaintext: 'Text',
    python: 'Python',
    shell: 'Shell',
    shellscript: 'Shell',
    sql: 'SQL',
    text: 'Text',
    ts: 'TypeScript',
    typescript: 'TypeScript',
    vue: 'Vue',
    xml: 'XML',
    yaml: 'YAML',
  };

  for (const pre of document.querySelectorAll<HTMLPreElement>('.note-content pre')) {
    const code = pre.querySelector('code');
    const parent = pre.parentNode;
    if (!code || !parent) continue;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    const toolbar = document.createElement('div');
    toolbar.className = 'code-block__toolbar';
    const language = document.createElement('span');
    language.className = 'code-language';
    const languageId = pre.dataset.language?.trim() || 'text';
    language.textContent = languageNames[languageId.toLocaleLowerCase()] ?? languageId;

    const button = document.createElement('button');
    button.className = 'code-copy';
    button.type = 'button';
    button.setAttribute('aria-label', copyLabel);
    button.title = copyLabel;
    button.innerHTML = copyIcon;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(code.textContent ?? '');
      button.classList.add('is-copied');
      button.setAttribute('aria-label', copiedLabel);
      button.title = copiedLabel;
      button.innerHTML = copiedIcon;
      window.setTimeout(() => {
        button.classList.remove('is-copied');
        button.setAttribute('aria-label', copyLabel);
        button.title = copyLabel;
        button.innerHTML = copyIcon;
      }, 1600);
    });

    parent.insertBefore(wrapper, pre);
    toolbar.append(language, button);
    wrapper.append(toolbar, pre);
  }
</script>
