---
import type { MarkdownHeading } from 'astro';
import { SITE } from '../../config/site';
import Icon from '../ui/Icon.astro';
import TableOfContentsBranch, { type TocHeading } from './TableOfContentsBranch.astro';

interface Props {
  headings?: MarkdownHeading[];
}

const headings = (Astro.props.headings ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const headingTree: TocHeading[] = [];
const stack: Array<{ depth: number; children: TocHeading[] }> = [{ depth: 1, children: headingTree }];

for (const heading of headings) {
  while (stack.length > 1 && stack.at(-1)!.depth >= heading.depth) stack.pop();
  const node = { ...heading, children: [] };
  stack.at(-1)!.children.push(node);
  stack.push(node);
}
---

{headings.length > 0 && (
  <>
    <aside class="toc" aria-label={SITE.contentsLabel}>
      <div class="toc__header">
        <div class="toc__title">{SITE.contentsLabel}</div>
        <button class="icon-button toc__toggle" id="toc-toggle" type="button" aria-label={SITE.expandContents} aria-controls="toc-navigation" aria-expanded="false">
          <span class="toc__toggle-icon toc__toggle-icon--expand"><Icon name="expand" size={15} /></span>
          <span class="toc__toggle-icon toc__toggle-icon--collapse"><Icon name="collapse" size={15} /></span>
        </button>
      </div>
      <nav class="toc__nav custom-scrollbar" id="toc-navigation">
        <ul class="toc__list">
          <TableOfContentsBranch headings={headingTree} />
        </ul>
      </nav>
    </aside>
    <div class="toc__actions">
      <button class="toc__top" id="toc-scroll-top" type="button">{SITE.scrollToTop}<span aria-hidden="true">↑</span></button>
    </div>
  </>
)}

<script>
  import { SITE } from '../../config/site';

  const root = document.documentElement;
  const toggleButton = document.querySelector<HTMLButtonElement>('#toc-toggle');
  const scrollTopButton = document.querySelector<HTMLButtonElement>('#toc-scroll-top');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc__link'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.toc__item'));
  const getLinkId = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.slice(1));
  const headings = links
    .map((link) => document.getElementById(getLinkId(link)))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length > 0) {
    const setActive = (id: string) => {
      let activeLink: HTMLAnchorElement | undefined;

      for (const link of links) {
        const active = getLinkId(link) === id;
        link.classList.toggle('is-active', active);
        if (active) activeLink = link;
      }

      for (const item of items) item.classList.remove('is-active-branch', 'is-active-ancestor');

      const activeItem = activeLink?.closest<HTMLElement>('.toc__item');
      if (!activeItem) return;

      activeItem.classList.add('is-active-branch');
      let ancestor = activeItem.parentElement?.closest<HTMLElement>('.toc__item') ?? null;

      while (ancestor) {
        ancestor.classList.add('is-active-branch', 'is-active-ancestor');
        ancestor = ancestor.parentElement?.closest<HTMLElement>('.toc__item') ?? null;
      }
    };

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
      if (visible[0]?.target.id) setActive(visible[0].target.id);
    }, { rootMargin: '-12% 0px -74% 0px' });

    headings.forEach((heading) => observer.observe(heading));
    setActive(headings[0].id);
  }

  const syncToggleButton = () => {
    if (!toggleButton) return;
    const expanded = root.dataset.toc === 'expanded';
    toggleButton.setAttribute('aria-expanded', String(expanded));
    toggleButton.setAttribute('aria-label', expanded ? SITE.collapseContents : SITE.expandContents);
  };

  toggleButton?.addEventListener('click', () => {
    const expanded = root.dataset.toc !== 'expanded';
    if (expanded) root.dataset.toc = 'expanded';
    else delete root.dataset.toc;
    localStorage.setItem('notes-toc', expanded ? 'expanded' : 'collapsed');
    syncToggleButton();
  });
  scrollTopButton?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  syncToggleButton();
</script>
