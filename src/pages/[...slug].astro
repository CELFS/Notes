---
import { SITE } from '../config/site';
import DirectoryPage from '../components/content/DirectoryPage.astro';
import {
  documentNotes,
  getAdjacentNotes,
  getBreadcrumbGroups,
  getNavigationGroups,
} from '../lib/notes';
import NotesLayout from '../layouts/NotesLayout.astro';

export function getStaticPaths() {
  const noteRoutes = new Set(documentNotes.map((note) => note.route));
  const directoryPaths = getNavigationGroups()
    .filter((group) => !noteRoutes.has(group.route))
    .map((group) => ({ params: { slug: group.route } }));

  return [
    ...documentNotes.map((note) => ({ params: { slug: note.route } })),
    ...directoryPaths,
  ];
}

const note = documentNotes.find((item) => item.route === Astro.params.slug);
const directory = note
  ? undefined
  : getNavigationGroups().find((group) => group.route === Astro.params.slug);
if (!note && !directory) throw new Error(`找不到发布路径：${Astro.params.slug}`);

const Content = note?.Content as any;
const adjacent = note ? getAdjacentNotes(note) : undefined;
const breadcrumbPath = note ? note.directory : directory?.path.slice(0, -1) ?? [];
const breadcrumbs = getBreadcrumbGroups(breadcrumbPath);
const title = note?.title ?? directory?.label;
---

<NotesLayout
  title={title}
  description={note?.description}
  activeId={note?.id}
  activeRoute={directory?.route}
  headings={note?.headings}
>
  <div class="document-overview">
    <div class="document-path" aria-label={SITE.documentPathLabel}>
      <a href={import.meta.env.BASE_URL}>{SITE.homeLabel}</a>
      {breadcrumbs.map((group) => <><span>/</span><a href={group.href}>{group.label}</a></>)}
    </div>
    {note && <div class="document-meta">{note.wordCount.toLocaleString('zh-CN')} {SITE.wordCountLabel}</div>}
  </div>
  {note ? (
    <article class="note-content">
      <Content />
    </article>
  ) : directory && <DirectoryPage group={directory} />}
  {adjacent && (adjacent.previous || adjacent.next) && (
    <nav class="article-pagination" aria-label={SITE.adjacentNotesLabel}>
      {adjacent.previous ? (
        <a href={adjacent.previous.href} rel="prev">
          <span>{SITE.previousLabel}</span>
          <strong>{adjacent.previous.title}</strong>
        </a>
      ) : <span></span>}
      {adjacent.next && (
        <a href={adjacent.next.href} rel="next">
          <span>{SITE.nextLabel}</span>
          <strong>{adjacent.next.title}</strong>
        </a>
      )}
    </nav>
  )}
</NotesLayout>
