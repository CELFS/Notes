---
import { SITE } from '../config/site';
import { homeNote } from '../lib/notes';
import NotesLayout from '../layouts/NotesLayout.astro';

const Content = homeNote?.Content as any;
---

<NotesLayout headings={homeNote?.headings}>
  <article class="note-content note-content--home">
    {Content ? <Content /> : (
      <div class="empty-state">
        <h1>{SITE.emptyTitle}</h1>
        <p>{SITE.emptyDescription}</p>
      </div>
    )}
  </article>
</NotesLayout>
