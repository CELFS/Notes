---
import { SITE } from '../../config/site';
import Icon from './Icon.astro';

const searchIndexUrl = `${import.meta.env.BASE_URL}search-index.json`;
---

<dialog
  class="search-dialog"
  id="search-dialog"
  aria-label={SITE.searchLabel}
  data-index-url={searchIndexUrl}
  data-empty-label={SITE.searchEmpty}
  data-initial-label={SITE.searchInitial}
>
  <div class="search-dialog__panel">
    <div class="search-dialog__field">
      <Icon name="search" size={18} />
      <input id="search-input" type="search" aria-label={SITE.searchLabel} placeholder={SITE.searchPlaceholder} autocomplete="off" />
      <button class="icon-button" id="search-close" type="button" aria-label={SITE.closeSearch}>
        <Icon name="close" />
      </button>
    </div>
    <div class="search-dialog__results custom-scrollbar" id="search-results">
      <p class="search-dialog__message">{SITE.searchInitial}</p>
    </div>
  </div>
</dialog>

<script>
  import { SITE } from '../../config/site';
  type SearchItem = {
    title: string;
    href: string;
    directory: string;
    text: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const results = document.querySelector<HTMLElement>('#search-results');
  let index: SearchItem[] | undefined;
  let loading: Promise<void> | undefined;
  let failed = false;

  const message = (value: string) => {
    if (!results) return;
    results.replaceChildren();
    const paragraph = document.createElement('p');
    paragraph.className = 'search-dialog__message';
    paragraph.textContent = value;
    results.append(paragraph);
  };

  const loadIndex = async () => {
    if (index || !dialog) return;
    if (loading) return loading;
    failed = false;
    loading = (async () => {
      const response = await fetch(dialog.dataset.indexUrl ?? '');
      if (!response.ok) throw new Error(String(response.status));
      index = await response.json();
    })();
    try { await loading; } finally { loading = undefined; }
  };

  const openSearch = async () => {
    if (!dialog) return;
    dialog.showModal();
    input?.focus();
    try {
      await loadIndex();
      renderResults();
    } catch {
      failed = true;
      message(SITE.searchError);
    }
  };

  const createSnippet = (text: string, query: string) => {
    const normalizedText = text.toLocaleLowerCase();
    const location = normalizedText.indexOf(query);
    if (location < 0) return text.slice(0, 120);
    const start = Math.max(0, location - 44);
    const end = Math.min(text.length, location + query.length + 76);
    return `${start > 0 ? '…' : ''}${text.slice(start, end)}${end < text.length ? '…' : ''}`;
  };

  const appendHighlightedText = (element: HTMLElement, value: string, query: string) => {
    const normalizedValue = value.toLocaleLowerCase();
    let cursor = 0;
    let location = normalizedValue.indexOf(query);

    while (location >= 0) {
      if (location > cursor) element.append(document.createTextNode(value.slice(cursor, location)));
      const highlight = document.createElement('mark');
      highlight.textContent = value.slice(location, location + query.length);
      element.append(highlight);
      cursor = location + query.length;
      location = normalizedValue.indexOf(query, cursor);
    }

    if (cursor < value.length) element.append(document.createTextNode(value.slice(cursor)));
  };

  const renderResults = () => {
    if (!input || !results || !dialog) return;
    const query = input.value.trim().toLocaleLowerCase();
    if (!query) {
      message(dialog.dataset.initialLabel ?? '');
      return;
    }
    if (!index) {
      message(failed ? SITE.searchError : SITE.searchLoading);
      return;
    }

    const matches = (index ?? [])
      .filter((item) => `${item.title} ${item.directory} ${item.text}`.toLocaleLowerCase().includes(query))
      .slice(0, 30);

    if (matches.length === 0) {
      message(dialog.dataset.emptyLabel ?? '');
      return;
    }

    results.replaceChildren();
    for (const item of matches) {
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = item.href;

      const title = document.createElement('strong');
      appendHighlightedText(title, item.title, query);
      const snippet = document.createElement('span');
      snippet.className = 'search-result__snippet';
      appendHighlightedText(snippet, createSnippet(item.text, query), query);

      link.append(title, snippet);
      results.append(link);
    }
  };

  document.querySelector('#search-open')?.addEventListener('click', openSearch);
  document.querySelector('#search-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  input?.addEventListener('input', renderResults);
  dialog?.addEventListener('keydown', (event) => {
    const links = Array.from(results?.querySelectorAll<HTMLAnchorElement>('.search-result') ?? []);
    if (!links.length) return;
    const current = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const next = event.key === 'ArrowDown' ? Math.min(current + 1, links.length - 1) : current - 1;
      if (next < 0) input?.focus();
      else links[next]?.focus();
    }
    if (event.key === 'Enter' && document.activeElement === input) {
      event.preventDefault();
      links[0]?.click();
    }
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === 'k') {
      event.preventDefault();
      dialog?.open ? dialog.close() : openSearch();
    }
    if (event.key === 'Escape' && dialog?.open) dialog.close();
  });
</script>
